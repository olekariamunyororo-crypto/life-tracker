# Copy to .env.local (or .env) and fill in.

# PostgreSQL connection (required)
POSTGRES_DATABASE_URL="postgresql://user:password@localhost:5432/lifetracker?schema=public"

# Clerk — REQUIRED IN PRODUCTION.
# With both keys set, every page and API route requires a signed-in user.
# With them unset the app uses a single local dev user ONLY when
# NODE_ENV !== "production"; in production it refuses to serve data (fail-closed).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
